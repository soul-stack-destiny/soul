[Unit]
Description=Soul Stack Soul agent
Documentation=https://github.com/souls-guild/soul-stack
# Soul initiates the gRPC stream to Keeper (ADR-002) - needs the network up.
After=network-online.target
Wants=network-online.target
# Restart rate limit - [Unit], not [Service]: systemd ignores these keys in
# [Service] ("Unknown key name ... ignoring"), which left the limiter dead.
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
# Type=notify + WatchdogSec (NIM-157): the unit start completes on READY=1 and a wedged
# agent - alive but not scheduling - is restarted by systemd, the only supervision an
# unattended VM has. The binary autodetects both, so the same build stays silent in
# docker/k8s.
Type=notify
NotifyAccess=main
ExecStart={{ .vars.bin_path }} run --config {{ .vars.config_path }}
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
WatchdogSec=60s
TimeoutStartSec=90s

# --- hardening (soft profile: Soul changes the system by nature) ---
# The same set the packaged unit ships (deploy/systemd/soul.service), and for the same
# reason: this process applies Destiny — it installs packages, edits /etc and manages
# services — so the strict profile a service daemon gets (ProtectSystem=strict, an empty
# CapabilityBoundingSet, ProtectHome) would break it wholesale rather than narrow it.
# Deliberately absent, NOT forgotten: ProtectSystem, ProtectHome, CapabilityBoundingSet,
# MemoryDenyWriteExecute. Do not tighten without running an apply cycle.
#
# ★ This set must stay equal to the packaged unit's, directive for directive: the two
# install models overwrite each other's unit at this very path, which is accepted, and only
# stays harmless while the bodies agree. Keep them in step by hand until the out-of-tree
# check exists (see the note in destiny.yml).
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Soul state directory: plugin/binary cache keyed by SHA-256, TLS material (SoulSeed).
ReadWritePaths=/var/lib/soul-stack

[Install]
WantedBy=multi-user.target
